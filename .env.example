# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# No real secrets here - placeholders only.
#
# Every variable the application reads is listed here and read in exactly one
# place, smarthack/config.py. tests/unit/test_repository_files.py fails when the
# two drift apart. Add a variable: accessor in config.py, line here, in that order.

# --- Application ----------------------------------------------------------
# Which environment this is: development, staging or production.
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Dispatch agent -------------------------------------------------------
# Where the agent reads crews, turbines and health predictions: memory (seed data) or supabase.
AGENT_DATA_SOURCE=memory

# --- Decision model (local Jeffan server) ---------------------------------
# Whether the dispatch agent may ask the local decision model, which picks the repair plan and the
# alert channel. Off by default: with it off the agent decides by rule and makes no HTTP call.
# Values that switch it on: 1, true, yes, on. Anything else leaves it off.
DECISION_MODEL_ENABLED=false

# Where the decision model server listens (`uv run python -I -m decision_model.server` in
# experiments/decision_model).
DECISION_MODEL_URL=http://127.0.0.1:8765

# umbra: the rule decides and the model's choice is only logged beside it (the safe default).
# activ: the model decides, checked by the code, with the rule as fallback.
DECISION_MODEL_MODE=umbra

# --- Wind Forecasting -----------------------------------------------------
# Directory where serialized models and feature columns reside.
WIND_MODELS_DIR=models/wind

# Directory where raw historical wind datasets reside.
WIND_DATA_DIR=data/wind

# --- Maintenance ----------------------------------------------------------
# Directory where serialized maintenance models and feature columns reside.
MAINTENANCE_MODELS_DIR=models/maintenance

# Directory where maintenance datasets reside.
MAINTENANCE_DATA_DIR=data/maintenance

# --- Real phone calls (experiments/alerting) -------------------------------
# When true, a CRITICAL alert of the dispatch agent phones on-call through the alerting module
# (email + voice call, with its allowlist, DRY_RUN and one-dispatch-per-alert gates). Off: the
# call is only logged. The module reads SENDER_*, ONCALL_*, ALLOWED_PHONES, DRY_RUN, TWILIO_*
# and CALL_PROVIDER from this same file; see experiments/alerting/.env.example.
# Needs `pip install -e ".[calls]"`. Values that switch it on: 1, true, yes, on.
VOICE_CALLS_ENABLED=false

# --- Local data lake (S3 + Lambda simulation) -----------------------------
# Root of the lake: one sub-folder per bucket (raw/, failed/). `make lake-watch` follows it.
LAKE_DIR=data/lake
# --- Hill wind resource atlas ----------------------------------------------
# Where `make resource` caches its downloads (NASA POWER, Global Wind Atlas, Copernicus DEM).
RESOURCE_CACHE_DIR=.data/resource

# Where the built atlas (heatmap, candidate sites, grid) is written and served from.
RESOURCE_ATLAS_DIR=models/resource

# --- Oversize transport network -------------------------------------------
# Where `make transport` caches the OpenStreetMap extract of Romania (~330 MB).
TRANSPORT_CACHE_DIR=.data/transport

# Where the built road network (network.json.gz, summary.json) is written and served from.
TRANSPORT_NETWORK_DIR=models/transport

# --- Server & Network -----------------------------------------------------
# Host to bind the FastAPI/Uvicorn server (127.0.0.1 locally, 0.0.0.0 in Docker).
SMARTHACK_HOST=127.0.0.1

# Port for the FastAPI/Uvicorn server.
SMARTHACK_PORT=8000

# Optional custom directory containing built frontend assets (index.html).
SMARTHACK_FRONTEND_DIST=

# Default HTTP timeout in seconds for outbound upstream requests.
SMARTHACK_HTTP_TIMEOUT=30

# Base directory for local data files.
SMARTHACK_DATA_DIR=./data

# Upstream example service base URL.
SMARTHACK_EXAMPLE_SERVICE_URL=http://localhost:9000

# Default timezone for daily business logic and date evaluation (e.g. Europe/Bucharest).
SMARTHACK_TIMEZONE=UTC

# --- Supabase -------------------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# API key from the same page. The `anon` key is enough to read what Row Level
# Security allows; `service_role` bypasses it and must never reach the frontend.
SUPABASE_KEY=changeme

# Service role key with administrative / RLS-bypass privileges for background jobs.
# Defaults to SUPABASE_KEY if not explicitly provided.
SUPABASE_SERVICE_KEY=

# Database password for Flyway migrations, used by `scripts/run_all.py` (not read by the app).
# FLYWAY_PASSWORD=

# --- Maintenance Job ------------------------------------------------------
# Recurring interval in minutes between background health prediction cycles.
MAINTENANCE_INTERVAL_MINUTES=60

# Comma-separated asset_id:scenario mappings for simulated demo failures.
# Available scenarios: normal, bearing_failure, gearbox_overheating, generator_vibration, sensor_drift.
MAINTENANCE_DEMO_SCENARIOS=

# --- Wind Forecast Job ----------------------------------------------------
# Interval in minutes between refreshes of the 7-day park wind forecast (720 = twice a day).
WIND_FORECAST_INTERVAL_MINUTES=720

# Open-Meteo forecast endpoint (free, no key needed).
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Gemini AI ------------------------------------------------------------
# Google Gemini API key for dynamic dispatch reasoning and speech synthesis.
GEMINI_API_KEY=
# --- Langfuse tracing (optional, needs the `monitoring` extra) --------------
# Whether the dispatch agent sends traces of its runs to Langfuse. Off by default. Values that
# switch it on: 1, true, yes, on. Without both keys below it does nothing even when on.
LANGFUSE_ENABLED=false

# Project keys: Langfuse -> Settings -> API Keys. Placeholders only; the real ones live in `.env`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The Langfuse server: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) or your own.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Credentials ----------------------------------------------------------
# Secrets never live in this file, only the name of the variable that holds one:
#   MY_SERVICE_API_KEY=changeme
# A client built from a credential belongs in config.py, wrapped in a try/except
# that leaves None behind, so the package imports and the tests run without it.
