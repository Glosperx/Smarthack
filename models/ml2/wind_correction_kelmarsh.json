{
  "name": "ML2 wind correction for Kelmarsh: weights per lead day with residual quantiles (method (c))",
  "created": "2026-11-08",
  "notebook": "notebooks/ml2_weather_correction.ipynb",
  "results": "notebooks/ml2_weather_correction.md",
  "scope": "Kelmarsh only (52.40 N, -0.94 E; 6 x Senvion MM92, hub 68.5-78.5 m). The numbers encode this park's error against its nacelle anemometers; do not apply them to another park. The method transfers; the numbers do not.",
  "target": {
    "name": "ws_obs",
    "unit": "m/s",
    "definition": "park mean of the nacelle wind speed of the turbines in operation: mean of the 10-minute rows from H - 30 min to H + 30 min, compared with the forecast valid at the full hour H (UTC)"
  },
  "inputs": {
    "api": "Open-Meteo; trained on the Previous Runs API (previous-runs-api.open-meteo.com), served from the Forecast API with the same `models`. Lead day d = whole days between the run and the valid hour (0..7).",
    "request": {
      "latitude": 52.4013,
      "longitude": -0.9435,
      "wind_speed_unit": "ms",
      "timezone": "GMT",
      "cell_selection": "land"
    },
    "models": {
      "ECMWF": {
        "open_meteo_model": "ecmwf_ifs025",
        "variable": "wind_speed_80m"
      },
      "GFS": {
        "open_meteo_model": "gfs_global",
        "variable": "wind_speed_80m"
      },
      "ICON": {
        "open_meteo_model": "icon_global",
        "variable": "wind_speed_80m"
      },
      "ICON-EU": {
        "open_meteo_model": "icon_eu",
        "variable": "wind_speed_80m"
      },
      "GEM": {
        "open_meteo_model": "gem_global",
        "variable": "wind_speed_80m"
      },
      "BOM": {
        "open_meteo_model": "bom_access_global",
        "variable": "wind_speed_80m"
      },
      "CMA": {
        "open_meteo_model": "cma_grapes_global",
        "variable": "wind_speed_120m"
      }
    },
    "missing": "ICON has no day 7 and ICON-EU no day 5-7; a missing model is replaced by ens_mean, the mean of the models available for that hour"
  },
  "formula": {
    "point": "ws_corr = intercept_d + sum_m weight_dm * ws_m",
    "quantiles": "q_j = ws_corr + residual_quantile_dj, alpha_j = 0.1, 0.2, ..., 0.9; clip at 0",
    "power": "feed each of the 9 quantile series through the ML2 wind-to-power model (serving recipe of feature_contract_15min.json) and average the 9 powers (expected power); P10 / P90 power from q10 / q90"
  },
