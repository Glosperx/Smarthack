# Copy to .env (same folder) and fill in. .env is gitignored; this file is not.
# No values here, ever. Phone numbers in E.164 form: +40 followed by the number,
# no leading 0, no spaces.

# --- Sender: who the alerts come FROM ---------------------------------------
# The Gmail account emails are sent from (logs in with GMAIL_APP_PASSWORD below).
SENDER_EMAIL=
# Caller ID shown when on-call is phoned. Twilio accepts only a number bought in
# Twilio or a number verified in the console as a Verified Caller ID.
SENDER_PHONE=

# --- Recipient: who the alerts go TO (oncall.json reads these through ${...}) --
ONCALL_EMAIL=
# On a Twilio trial this number must also be a Verified Caller ID.
ONCALL_PHONE=

# --- Allowlist: enforced in code, a recipient missing here is refused --------
# Comma-separated. ONCALL_EMAIL / ONCALL_PHONE must be listed here to be reached.
ALLOWED_EMAILS=
ALLOWED_PHONES=

# --- Sending mode ------------------------------------------------------------
# Empty or true: only show what would be sent. Only `false` sends anything.
DRY_RUN=
# Where emails go: mailpit (local container, the default) or gmail.
EMAIL_BACKEND=
# Display name on the From line. Empty: "Monitorizare parc eolian".
SENDER_NAME=
# Mailpit address, only if not the defaults 127.0.0.1 and 1025.
MAILPIT_HOST=
MAILPIT_SMTP_PORT=

# --- Credentials -------------------------------------------------------------
# Gmail App Password for SENDER_EMAIL (16 characters), needed only with gmail.
GMAIL_APP_PASSWORD=
# Twilio, from the Account Info panel of console.twilio.com (used from step 4).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Call options (all optional) -----------------------------------------------
# <Say> voice: Google.ro-RO-Wavenet-B (default), Google.ro-RO-Standard-B or Polly.Carmen.
TWILIO_VOICE=
# Seconds of ringing before Twilio gives up with no-answer. Empty: 30.
CALL_RING_TIMEOUT=
# Seconds for answering machine detection. Empty: 10.
CALL_AMD_TIMEOUT=

# --- Call provider -------------------------------------------------------------
# Who places calls: twilio (default) or infobip.
CALL_PROVIDER=
# Infobip: API key and the account's personal Base URL (xxxxx.api.infobip.com),
# both from the Infobip portal.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
# Optional. Romanian voice; empty: Carmen (standard, free). Neural: Alina, Emil.
INFOBIP_VOICE=
# Optional caller ID in E.164; empty: the trial's pre-registered sender.
INFOBIP_FROM=
# Optional: continue or hangup. Empty: off (Infobip enables it per account on request).
INFOBIP_MACHINE_DETECTION=

# --- Escalation ----------------------------------------------------------------
# Minutes before calling the same person again after no answer, busy or a machine. Empty: 5.
ESCALATION_RETRY_MINUTES=
# Extra calls to the same person after a call nobody answers. Empty: 1. 0: one call only.
CALL_RETRIES_PER_PERSON=
